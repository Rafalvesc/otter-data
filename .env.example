# Create your .env with: python -m scripts.init_env (it generates local passwords automatically).
# Do not use these placeholders as passwords and do not share the .env file.
POSTGRES_DB=datapilot
POSTGRES_USER=datapilot_admin
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_ADMIN_PASSWORD
ANALYTICS_PASSWORD=REPLACE_WITH_RANDOM_ANALYTICS_PASSWORD
SEED_PASSWORD=REPLACE_WITH_RANDOM_SEED_PASSWORD
POSTGRES_PORT=55432
DATABASE_HOST=127.0.0.1
DATABASE_PORT=55432
DATABASE_NAME=datapilot
QUERY_TIMEOUT_SECONDS=10
MAX_ROWS=10000
MAX_RESULT_BYTES=1000000

# LLM provider: ollama (default) or demo (scripted answers with no model; used in tests).
LLM_PROVIDER=ollama
# Ollama: local daemon; -cloud models require `ollama signin`. No API key in the app.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:31b-cloud
# Extra models in the picker (comma-separated). Local models installed with `ollama pull`
# show up automatically; cloud models can be listed here.
OLLAMA_MODELS=
# Local models run on this machine's CPU/GPU and need more time.
LOCAL_LLM_TIMEOUT_SECONDS=120
LOCAL_REQUEST_TIMEOUT_SECONDS=480
# Context window requested from local models (tokens). Ollama's default (4096) cuts the
# start of long instructions; lower it only if memory runs short.
LOCAL_CONTEXT_TOKENS=16384
LLM_TIMEOUT_SECONDS=20
REQUEST_TIMEOUT_SECONDS=60
MAX_LLM_CALLS=4
MAX_CONCURRENT_REQUESTS=4
# Exploratory questions (free-form, validated SQL) besides the versioned metrics.
EXPLORATION_ENABLED=true
# Natural-language answers: sends up to NARRATIVE_MAX_ROWS result rows to the model.
NARRATIVE_ENABLED=true
NARRATIVE_MAX_ROWS=50
# Connected sources: folder for their settings and imported CSVs (default: %LOCALAPPDATA%\OtterData).
# Passwords are never stored here: they go to the Windows Credential Manager.
# DATA_DIR=
CSV_MAX_MB=50

# Who built this installation (the assistant says it when asked).
OTTER_AUTHOR=
# Previous exchanges of the conversation sent to the model as context (0 turns it off).
HISTORY_TURNS=6
